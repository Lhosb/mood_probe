#!/usr/bin/env ruby

require "json"
require "optparse"
require "pathname"
require "sonance"

def print_model_license_notice(registry)
  registry.models.each do |model|
    puts [
      "MODEL LICENSE #{model.id}:",
      model.license,
      "|",
      model.attribution,
      "|",
      model.source_url,
      "| non-commercial use only"
    ].join(" ")
  end
end

options = {
  models_dir: ENV.fetch("SONANCE_MODELS_DIR", File.expand_path("~/.cache/sonance/models")),
  timeout_per_file: 60,
  python_executable: "python3"
}
descriptors = nil

OptionParser.new do |parser|
  parser.banner = "Usage: sonance [options] analyze FILE | descriptors | models verify | models fetch"
  parser.on("--models-dir DIR") { |value| options[:models_dir] = value }
  parser.on("--timeout SECONDS", Integer) { |value| options[:timeout_per_file] = value }
  parser.on("--python EXECUTABLE") { |value| options[:python_executable] = value }
  parser.on("--descriptors IDS", Array) { |values| descriptors = values.map(&:strip).reject(&:empty?).map(&:to_sym) }
end.parse!(ARGV)

begin
  command = ARGV.shift

  case command
  when "analyze"
    path = ARGV.shift or abort("analyze requires FILE")
    abort("analyze requires --descriptors IDS") if descriptors.nil? || descriptors.empty?

    extractor = Sonance::Extractor.new(**options)
    puts JSON.pretty_generate(extractor.analyze(path, descriptors:).to_h)
  when "descriptors"
    puts Sonance::Registry.default.ids
  when "models"
    subcommand = ARGV.shift
    case subcommand
    when "verify"
      registry = Sonance::Registry.default
      Sonance::ModelStore.new(options.fetch(:models_dir), registry:).verify!(
        filenames: registry.models.map(&:filename)
      )
      puts "Models verified"
    when "fetch"
      registry = Sonance::Registry.default
      print_model_license_notice(registry)
      Sonance::ModelStore.new(options.fetch(:models_dir), registry:).fetch!
      puts "Models fetched and verified"
    else
      abort("models requires verify or fetch")
    end
  else
    abort("expected analyze, descriptors, or models")
  end
rescue Sonance::Error => e
  warn e.message
  exit 1
end
